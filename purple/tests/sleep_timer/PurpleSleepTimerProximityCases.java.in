final class SystemClock {
    static long now=1_000_000L;
    static long elapsedRealtime() { return now; }
}
final class AudioManager { static final int STREAM_VOICE_CALL=0, STREAM_MUSIC=3; }
final class NotificationCenter {
    static final int audioRouteChanged=1;
    static int posts,account;
    static NotificationCenter getInstance(int value) { account=value; return new NotificationCenter(); }
    void postNotificationName(int kind,Object... values) { if(kind!=audioRouteChanged)throw new AssertionError("unexpected notification");posts++; }
}
final class AndroidUtilities {
    static final ArrayList<Runnable> queued=new ArrayList<>();
    static void runOnUIThread(Runnable action,int delay) { if(delay!=100)throw new AssertionError("route delay");queued.add(action); }
    static void drain() { ArrayList<Runnable> copy=new ArrayList<>(queued);queued.clear();for(Runnable action:copy)action.run(); }
}
final class VideoPlayer {
    static int nativeStarts;
    static final class Backend {
        boolean playing;
        void setPlayWhenReady(boolean value) { playing=value;if(value)nativeStarts++; }
    }
    Backend player=new Backend(),audioPlayer;
    boolean mixedPlayWhenReady,mixedAudio,audioPlayerReady,videoPlayerReady;
    int streamType,seekCalls;
    long position=7000;
    boolean isPlaying() { return player.playing; }
    void setStreamType(int type) { streamType=type; }
    long getCurrentPosition() { return position; }
    void seekTo(long value) { position=value;seekCalls++; }
    //@EXTRACT native public void play() {
    void pause() { player.playing=false; }
}
final class MessageObject {
    static final class Document { long id;Document(long value){id=value;} }
    final int currentAccount,id;
    final long dialog;
    final Kind kind;
    final Document document;
    float audioProgress=.4f;
    int audioPlayerDuration=180;
    MessageObject(int account,int value,Kind type) { currentAccount=account;id=value;dialog=account+7000;kind=type;document=new Document(9000+value); }
    Document getDocument() { return document; }
    boolean isMusic() { return kind==Kind.SONG; }
    boolean isRoundVideo() { return kind==Kind.ROUND; }
    boolean isVoice() { return kind==Kind.VOICE; }
    boolean isVideo() { return kind==Kind.VIDEO; }
    long getDialogId() { return dialog; }
    int getId() { return id; }
}
