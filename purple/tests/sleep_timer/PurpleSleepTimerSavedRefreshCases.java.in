final class SystemClock {
    static long now = 1_000_000L;
    static long elapsedRealtime() { return now; }
}

final class SharedConfig { static boolean shuffleMusic; }

final class NotificationCenter {
    static final int moreMusicDidLoad = 1;
    private static final NotificationCenter INSTANCE = new NotificationCenter();
    int posts;
    static NotificationCenter getInstance(int account) { return INSTANCE; }
    void postNotificationName(int id, Object... args) { posts++; }
}

final class VideoPlayer {}

final class MessageObject {
    static final class Document { final long id; Document(long id) { this.id = id; } }
    final int currentAccount, id;
    final long dialog;
    final Document document;
    float audioProgress;
    MessageObject(int account, long dialog, int id, long document) {
        currentAccount = account;
        this.dialog = dialog;
        this.id = id;
        this.document = new Document(document);
    }
    Document getDocument() { return document; }
    boolean isMusic() { return true; }
    boolean isRoundVideo() { return false; }
    boolean isVoice() { return false; }
    boolean isVideo() { return false; }
    long getDialogId() { return dialog; }
    int getId() { return id; }
}

