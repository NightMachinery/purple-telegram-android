final class MediaController {
    static final class SavedMusicList { final ArrayList<MessageObject> list = new ArrayList<>(); }
    final ArrayList<MessageObject> playlist = new ArrayList<>();
    final ArrayList<MessageObject> shuffledPlaylist = new ArrayList<>();
    int currentPlaylistNum;
    MessageObject playingMessageObject;
    SavedMusicList currentSavedMusicList;
    PurpleSleepTimerAudio purpleSleep;
    boolean resumeAudioOnFocusGain, wasPlayingAudioBeforePause;
    // Observable stock state: whether the inert stock player is audible, and how often it was started.
    boolean isPaused = true, audible;
    int starts, cleanups;

    void musicListLoaded(Object[] args) {
        //@EXTRACT media if (currentSavedMusicList != null && args[0] == currentSavedMusicList) {
    }
    //@EXTRACT media public boolean playMessage(final MessageObject messageObject) {
    //@EXTRACT media public boolean playMessage(final MessageObject messageObject, boolean silent) {
    //@EXTRACT media public void purpleSleepFence() {

    // Inert stock endpoints.
    private boolean purpleSleepPlayMessage(MessageObject messageObject, boolean silent) {
        playingMessageObject = messageObject;
        isPaused = false;
        audible = true;
        starts++;
        return true;
    }
    public void purpleSleepPauseLocal() { isPaused = true; audible = false; }
    public void purpleSleepFinishVoice() {}
    public MessageObject getPlayingMessageObject() { return playingMessageObject; }
    public boolean isMessagePaused() { return isPaused; }
    public boolean seekToProgress(MessageObject message, float progress) { return true; }
    private void sortPlaylist() {}
    private void buildShuffledPlayList() {}
    public void cleanup() { cleanups++; playingMessageObject = null; isPaused = true; audible = false; }
}

public final class PurpleSleepTimerSavedRefreshCases {
    private static int checks;
    private static void check(boolean condition, String name) {
        checks++;
        if (!condition) throw new AssertionError(name);
    }
    private static MessageObject song(int id) { return new MessageObject(0, 7000, id, 9000 + id); }

    private static final class Harness {
        final MediaController controller = new MediaController();
        final MediaController.SavedMusicList saved = new MediaController.SavedMusicList();
        final PurpleSleepTimer timer;
        Harness(MessageObject... songs) {
            PurpleSleepTimer.reset();
            timer = PurpleSleepTimer.get();
            controller.purpleSleep = new PurpleSleepTimerAudio(controller);
            controller.currentSavedMusicList = saved;
            saved.list.addAll(Arrays.asList(songs));
            controller.playlist.addAll(saved.list);
        }
        void refresh(MessageObject... songs) {
            saved.list.clear();
            saved.list.addAll(Arrays.asList(songs));
            controller.musicListLoaded(new Object[]{saved});
        }
        void startTimer() { check(timer.rules.timed(SystemClock.now, MINUTE), "fixture starts a one-minute timer"); }
        void elapse() { SystemClock.now += MINUTE; }
        boolean blocked() { return timer.blocked(Slot.AUDIO); }
    }

    public static void main(String[] args) {
        final MessageObject s1 = song(1), s2 = song(2), s3 = song(3);

        Harness healthy = new Harness(s1, s2, s3);
        check(healthy.controller.playMessage(s2) && healthy.controller.audible
                && healthy.controller.playingMessageObject == s2, "user Play starts the selected song");
        healthy.refresh(s1, s3);
        check(healthy.controller.audible && healthy.controller.playingMessageObject == s1
                && healthy.controller.starts == 2, "healthy refresh keeps the stock automatic fallback");
        check(!healthy.blocked(), "healthy fallback leaves automatic playback allowed");

        Harness expired = new Harness(s1, s2, s3);
        check(expired.controller.playMessage(s2), "user Play before the timer");
        expired.controller.resumeAudioOnFocusGain = expired.controller.wasPlayingAudioBeforePause = true;
        expired.startTimer();
        expired.elapse();
        expired.timer.check();
        check(!expired.controller.audible && expired.controller.isPaused && expired.blocked(), "timed expiry pauses locally and blocks");
        check(!expired.controller.resumeAudioOnFocusGain && !expired.controller.wasPlayingAudioBeforePause, "expiry fences stock resumes");
        expired.refresh(s1, s3);
        check(!expired.controller.audible && expired.controller.starts == 1, "refresh missing the paused song stays silent");
        check(expired.blocked(), "refresh does not grant Play");
        check(expired.controller.playingMessageObject == s2 && expired.controller.isPaused
                && PurpleSleepTimer.item(s2).equals(expired.timer.current(Slot.AUDIO)), "paused selection is retained");
        check(expired.controller.playlist.equals(Arrays.asList(s1, s3)), "the refreshed list is still adopted");
        expired.refresh(s3);
        check(!expired.controller.audible && expired.blocked() && expired.controller.starts == 1, "repeated refresh stays silent");
        expired.refresh(s1, s2, s3);
        check(!expired.controller.audible && expired.blocked() && expired.controller.currentPlaylistNum == 1, "refresh that restores the song only reindexes");
        check(expired.controller.playMessage(s1) && expired.controller.audible
                && expired.controller.playingMessageObject == s1 && !expired.blocked(), "deliberate user Play grants a new intent");
        expired.refresh(s2, s3);
        check(expired.controller.audible && expired.controller.playingMessageObject == s2 && expired.controller.starts == 3,
                "after user Play the fallback is automatic again");

        Harness due = new Harness(s1, s2, s3);
        check(due.controller.playMessage(s2), "user Play before an unchecked deadline");
        due.startTimer();
        due.elapse();
        due.refresh(s1, s3);
        check(!due.controller.audible && due.blocked() && due.controller.playingMessageObject == s2,
                "a deadline that passed unchecked expires before the fallback");

        System.out.println("SLEEP_TIMER_SAVED_REFRESH_CHECKS=" + checks);
    }
}
