final class LongSparseArray<E> {
    private final HashMap<Long, E> values = new HashMap<>();
    E get(long key) { return values.get(key); }
    void put(long key, E value) { values.put(key, value); }
    void remove(long key) { values.remove(key); }
    void clear() { values.clear(); }
}

final class Prefs {
    static final Map<String, Long> stored = new HashMap<>();
    final class Editor {
        Editor putLong(String key, long value) { stored.put(key, value); return this; }
        void apply() {}
    }
    Editor edit() { return new Editor(); }
}

final class MessagesController {
    static Prefs getNotificationsSettings(int account) { return new Prefs(); }
}

final class AndroidUtilities {
    static final ArrayList<Runnable> queued = new ArrayList<>();
    static final ArrayList<Long> delays = new ArrayList<>();
    static long getPrefIntOrLong(Prefs prefs, String key, long fallback) {
        final Long value = Prefs.stored.get(key);
        return value == null ? fallback : value;
    }
    static void runOnUIThread(Runnable runnable, long delay) { queued.add(runnable); delays.add(delay); }
    static void drain() {
        final ArrayList<Runnable> due = new ArrayList<>(queued);
        queued.clear();
        delays.clear();
        for (Runnable runnable : due) runnable.run();
    }
}

final class MediaSessionCompat {
    static final class QueueItem {}
    List<QueueItem> queue;
    CharSequence title;
    boolean released;
    void setQueue(List<QueueItem> value) { queue = value; }
    void setQueueTitle(CharSequence value) { title = value; }
    void release() { released = true; }
}

final class MessageObject {
    static final class Document { final long id; Document(long id) { this.id = id; } }
    final int currentAccount, id;
    final long dialog;
    final Document document;
    final char kind;
    float audioProgress, forceSeekTo = -1;
    MessageObject(int account, long dialog, int id, char kind) {
        currentAccount = account;
        this.dialog = dialog;
        this.id = id;
        this.kind = kind;
        document = new Document(dialog * 1000 + id);
    }
    Document getDocument() { return document; }
    boolean isMusic() { return kind == 'm'; }
    boolean isRoundVideo() { return kind == 'r'; }
    boolean isVoice() { return kind == 'v'; }
    boolean isVideo() { return kind == 'f'; }
    double getDuration() { return 100; }
    long getDialogId() { return dialog; }
    int getId() { return id; }
}

