final class MediaController {
    private static MediaController instance;
    static MediaController getInstance() { return instance; }
    static MediaController reset() {
        instance = new MediaController();
        instance.purpleSleep = new PurpleSleepTimerAudio(instance);
        return instance;
    }
    final ArrayList<MessageObject> playlist = new ArrayList<>();
    MessageObject playingMessageObject;
    PurpleSleepTimerAudio purpleSleep;
    boolean resumeAudioOnFocusGain, wasPlayingAudioBeforePause;
    // Observable stock state: whether the inert stock player is audible, and how often it was started.
    boolean isPaused = true, audible;
    int starts;

    //@EXTRACT media public boolean playMessage(final MessageObject messageObject) {
    //@EXTRACT media public boolean playMessage(final MessageObject messageObject, boolean silent) {
    //@EXTRACT media public void purpleSleepFence() {

    // Inert stock endpoints. Stock setPlaylist ends by calling playMessage(current) for a new list;
    // stock pauseMessage starts with the production purpleSleep.pauseRequested() hook.
    public boolean setPlaylist(ArrayList<MessageObject> messages, MessageObject current, long mergeDialogId, boolean loadMusic, Object params) {
        playlist.clear();
        playlist.addAll(messages);
        return playMessage(current);
    }
    public boolean pauseMessage(MessageObject messageObject) {
        purpleSleep.pauseRequested();
        if (messageObject == null || messageObject != playingMessageObject) return false;
        isPaused = true;
        audible = false;
        return true;
    }
    private boolean purpleSleepPlayMessage(MessageObject messageObject, boolean silent) {
        playingMessageObject = messageObject;
        isPaused = false;
        audible = true;
        starts++;
        return true;
    }
    public void purpleSleepPauseLocal() { isPaused = true; audible = false; }
    public void purpleSleepFinishVoice() {}
    public MessageObject getPlayingMessageObject() { return playingMessageObject; }
    public boolean isMessagePaused() { return isPaused; }
    public boolean seekToProgress(MessageObject message, float progress) { return true; }
}

