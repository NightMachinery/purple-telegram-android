{
  "about": "Canonical list of the Purple Android host suites that purple/run_host_suites.py runs. A patch that adds, renames or removes a driver, or a --suite value of one, updates this list in the same commit; a driver no configuration runs yet is recorded under undriven with the reason, and a shell driver that only execs one --suite of a listed driver is recorded under aliases. agp-compile and agp-compile-standalone are the real AGP javac of the library module for the debug and standalone variants, each providing its receipt; a suite names the receipt it tests by placeholder, {receipt} or {standalone-receipt}, and links host-library ({library}), the app's purplecore sources built for the host.",
  "aliases": {
    "TMessagesProj/jni/purple_jni/tests/run_account_sync_store.sh": "modern-sync",
    "TMessagesProj/jni/purple_jni/tests/run_config_sync_bridge.sh": "modern-sync",
    "TMessagesProj/jni/purple_jni/tests/run_sync_executors.sh": "modern-sync",
    "TMessagesProj/jni/purple_jni/tests/run_sync_history.sh": "modern-sync",
    "TMessagesProj/jni/purple_jni/tests/run_sync_transport.sh": "modern-sync-auto"
  },
  "undriven": {
    "TMessagesProj/jni/purple_jni/tests/run_account_sync_acknowledgement.sh": "B3: builds its own native smoke library; its Qt and JDK defaults need runner options first.",
    "TMessagesProj/jni/purple_jni/tests/run_build_version.sh": "B3: needs JDK 21 and a Gradle launcher of its own, in a temporary Gradle home.",
    "TMessagesProj/jni/purple_jni/tests/run_archive.py": "B3, first: needs the bundled-SQLite JNI library and the core library built for the host.",
    "purple/tests/run_markdown_host.py": "B3: takes its own hold helper; its hold should go through the runner's compile wrapper instead."
  },
