   check(screen.picker.isFinished&&NativeWriterFixture.text(account).contains("user:17")&&NativeWriterFixture.text(1-account).equals(other),"real writer/editor typed membership publishes only opening account and closes picker");
   check(NativeWriterFixture.synced==1&&NativeWriterFixture.notified==1,"publication refresh has normal notify and sync ACK");
  }
