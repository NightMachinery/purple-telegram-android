  screen=fresh(1,"follow");screen.select();NativeWriterFixture.replace(1,"version=2\n[media_reply.sets.Pick]\npeers=['user:99']\n");screen.picker.choose(17);check(NativeWriterFixture.writes==0&&!screen.picker.isFinished&&NativeWriterFixture.text(1).contains("user:99"),"external opening membership replacement refuses");
  screen=fresh(1,"follow");screen.select();NativeWriterFixture.duringWrite=()->NativeWriterFixture.replace(1,"version=2\n[media_reply.sets.Pick]\npeers=['user:77']\n");screen.picker.choose(17);check(!screen.picker.isFinished&&NativeWriterFixture.synced==0&&NativeWriterFixture.text(1).contains("user:77"),"replacement during real backup write refuses target publication");
  screen=fresh(1,"follow");screen.select();NativeWriterFixture.afterRefresh=()->NativeWriterFixture.replace(1,"version=2\n[media_reply.sets.Pick]\npeers=['user:66']\n");screen.picker.choose(17);check(!screen.picker.isFinished&&NativeWriterFixture.synced==0&&NativeWriterFixture.text(1).contains("user:66"),"post-publication external replacement fails expected committed snapshot ACK");
  screen=fresh(1,"follow");NativeWriterFixture.ordinaryFollowControl();check(NativeWriterFixture.mode()==1,"ordinary Work Mode route remains global");
  System.out.println("MEDIA_REPLY_NATIVE_WRITER_CHECKS="+checks);
 }
