<?xml version="1.0" encoding="utf-8"?>
<!--
  Purple: the fork's own launcher icon. Built the way the Aqua icon is - a
  gradient behind the stock foreground - so it is recognisably Telegram at a
  glance while never being mistaken for the official app on the same phone.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:type="linear"
        android:angle="45"
        android:startColor="#5B2AC6"
        android:centerColor="#8E44E8"
        android:endColor="#B96BFF" />
</shape>
